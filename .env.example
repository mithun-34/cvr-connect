# ── Database ─────────────────────────────────────────────────────────────────
# Free PostgreSQL from Neon: https://neon.tech
DATABASE_URL=
# ── Clerk ─────────────────────────────────────────────────────────────────────
# Create a free app at https://clerk.com
CLERK_PUBLISHABLE_KEY=
# Publishable key goes in the frontend (safe to expose)
VITE_CLERK_PUBLISHABLE_KEY=
# Secret key goes on the backend only (never expose this)
CLERK_SECRET_KEY=
# ── Admin ─────────────────────────────────────────────────────────────────────
# Any strong random string — used to access /api/admin/* routes
# Generate one: openssl rand -hex 32
ADMIN_TOKEN=
# ── Server ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
